# lf-report-render — environment reference. No real values committed.

# Shared secret between n8n and this service. When unset the service runs
# OPEN and says so on /health — enforcement turns on by setting it (the
# LP-MCP house convention). Railway always sets it.
RENDER_TOKEN=

# The service itself is stateless and does not read Supabase; these are
# documented here because the RUNBOOK's incident tooling (re-render a stored
# payload, verify a stored hash) uses them from the same shell.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Master kill switch documented for parity: the AUTHORITATIVE switch is the
# lf_report_config row 'report_enabled' in LP Supabase (auditable, D4) —
# Workflow 01 reads that row, not this variable.
LF_REPORT_ENABLED=false
