# lf-report-render — environment reference. No real values committed.

# Shared secret between n8n and this service. When unset the service runs
# OPEN and says so on /health — enforcement turns on by setting it (the
# LP-MCP house convention). Railway always sets it.
RENDER_TOKEN=

# LP Supabase access over the IPv4 SESSION POOLER as the dedicated
# least-privilege role lf_report_svc (Phase-E adaptation). The render service
# owns all LP reads and writes; n8n never connects to Postgres. This is the
# ONLY place the role password lives — never in git, never in n8n JSON.
# Shape (session pooler, port 5432; the pooler user is role.projectref):
#   postgresql://lf_report_svc.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# For this project (rcjcgjlqzepicbwhnnjl, us-east-2) the pooler host is
# aws-1-us-east-2.pooler.supabase.com. NOTE the shard is aws-1, not aws-0 —
# aws-0 answers but does not host this tenant ("Tenant or user not found").
# The custom role works fine through the correct shard; no IPv6 needed. Verify
# with GET /health -> db.ok:true.
SUPABASE_DB_URL=

# Master kill switch documented for parity: the AUTHORITATIVE switch is the
# lf_report_config row 'report_enabled' in LP Supabase (auditable, D4) —
# run_weekly reads that row, not this variable, and exits unless it is true.
LF_REPORT_ENABLED=false
