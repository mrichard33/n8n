   "typeVersion": 2,
   "position": [
    240,
    200
   ],
   "parameters": {
    "jsCode": "// Route on the LP report ID embedded in the attachment filename\n// (mrichard5152_137_..._Sales_Efficiency_By_Mode.pdf) — stable and\n// machine-readable, unlike email subjects. Unroutable files go to\n// telemetry, never a silent drop.\nconst SLUGS = {\n  '133': 'jobs-by-status',\n  '134': 'jobs-by-milestone',\n  '135': 'lead-disposition',\n  '136': 'source-cost',\n  '137': 'sales-efficiency',\n};\nreturn $input.all().map((item) => {\n  const name = item.binary?.attachment_0?.fileName || '';\n  const m = name.match(/_1(3[3-7])_/);\n  const id = m ? `1${m[1]}` : null;\n  item.json.attachment_name = name;\n  item.json.report_id = id;\n  item.json.slug = id ? SLUGS[id] : 'unroutable';\n  return item;\n});"
   }
  },
