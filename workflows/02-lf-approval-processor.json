{
  "name": "02 LF Approval Processor",
  "nodes": [
    {
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Gmail Trigger: approval replies",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [240, 260],
      "parameters": {
        "pollTimes": { "item": [ { "mode": "everyX", "value": 5, "unit": "minutes" } ] },
        "simple": true,
        "filters": { "q": "subject:LR- newer_than:7d" }
      },
      "credentials": { "gmailOAuth2": { "id": "mTZ0abLJTGV5FMrz", "name": "updates@reecewindowsmail.com" } }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Extract token + sender + reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 260],
      "parameters": {
        "jsCode": "// Pull the run token from the subject, the sender address and the raw\n// reply body. The render service does all the §14 parsing; this only\n// forwards raw text — no decision logic here.\nconst m = $json;\nconst subject = m.subject || m.Subject || '';\nconst tok = (subject.match(/LR-\\d{4}-W\\d+-V\\d+/) || [])[0] || '';\nconst fromRaw = m.from || m.From || (m.headers && m.headers.from) || '';\nconst email = (String(fromRaw).match(/[\\w.+-]+@[\\w.-]+/) || [''])[0].toLowerCase();\nconst raw = m.text || m.textPlain || m.snippet || '';\nreturn [{ json: { token: tok, sender_email: email, raw_reply: raw, subject } }];"
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Decide (render service §14)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 260],
      "parameters": {
        "method": "POST",
        "url": "https://lf-report-render-production.up.railway.app/approval/decide",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ token: $json.token, sender_email: $json.sender_email, raw_reply: $json.raw_reply, channel: 'email_reply' }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "IF approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1080, 200],
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "combinator": "and",
          "conditions": [ { "id": "c-app", "leftValue": "={{ $json.action }}", "rightValue": "approved", "operator": { "type": "string", "operation": "equals" } } ] }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Trigger 04 delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 140],
      "parameters": {
        "method": "POST",
        "url": "https://n8n-main-instance-production-981e.up.railway.app/webhook/lf-deliver",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ version_id: $json.version_id }) }}",
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "IF edit",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1080, 340],
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "combinator": "and",
          "conditions": [ { "id": "c-edit", "leftValue": "={{ $json.action }}", "rightValue": "edit", "operator": { "type": "string", "operation": "equals" } } ] }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Trigger 03 revision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 300],
      "parameters": {
        "method": "POST",
        "url": "https://n8n-main-instance-production-981e.up.railway.app/webhook/lf-revise",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, revision_kind: $json.revision_kind, instruction: $json.instruction, requested_by: $('Extract token + sender + reply').item.json.sender_email }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Notify internal (deny / unauthorized / unclear)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1360, 460],
      "parameters": {
        "sendTo": "m.richard@reecewindows.com",
        "subject": "=Lightfire approval — {{ $json.action }} ({{ $('Extract token + sender + reply').item.json.token }})",
        "emailType": "text",
        "message": "=A reply on the Lightfire approval thread was classified as: {{ $json.action }}.\n\nsender: {{ $('Extract token + sender + reply').item.json.sender_email }}\nreason: {{ $json.reason || '—' }}\n\ndeny = nothing is sent; discuss.\nunauthorized = reply from an address not on lf_report_approvers.\nunknown = unrecognised reply; the run stays pending (silence never approves).",
        "options": { "appendAttribution": false, "senderName": "Reece Windows & Doors" }
      },
      "credentials": { "gmailOAuth2": { "id": "mTZ0abLJTGV5FMrz", "name": "updates@reecewindowsmail.com" } }
    },
    {
      "id": "b2000000-0000-4000-8000-00000000000a",
      "name": "Webhook: decision buttons",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 480],
      "webhookId": "lf-decision-buttons",
      "parameters": { "httpMethod": "POST", "path": "lf-decision", "responseMode": "responseNode", "options": {} }
    },
    {
      "id": "b2000000-0000-4000-8000-00000000000b",
      "name": "Decide (button)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 480],
      "parameters": {
        "method": "POST",
        "url": "https://lf-report-render-production.up.railway.app/approval/decide",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ token: $json.body.token, sender_email: $json.body.sender_email, raw_reply: $json.body.action, channel: 'webhook_button' }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-00000000000c",
      "name": "Respond button",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 480],
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify({ action: $json.action }) }}" }
    },
    {
      "id": "b2000000-0000-4000-8000-00000000000d",
      "name": "Schedule: hourly reminders",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [240, 700],
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 * * * *" } ] } }
    },
    {
      "id": "b2000000-0000-4000-8000-00000000000e",
      "name": "Reminders tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 700],
      "parameters": {
        "method": "POST",
        "url": "https://lf-report-render-production.up.railway.app/reminders/tick",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" } ] },
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-00000000000f",
      "name": "Split due reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 700],
      "parameters": { "jsCode": "return ($json.reminders || []).map(r => ({ json: r }));" }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000010",
      "name": "Send reminder to approvers",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1080, 700],
      "parameters": {
        "sendTo": "={{ ($json.sent_to || ['m.richard@reecewindows.com']).join(',') }}",
        "subject": "=Reminder ({{ $json.tier_hours }}h) — Lightfire weekly still needs your approval [{{ $json.token }}]",
        "emailType": "text",
        "message": "=The Lightfire weekly report is still awaiting your decision ({{ $json.tier_hours }} hours on).\n\nReply APPROVED, DENY: <reason>, or EDIT: <what to change> on the original thread. Silence never approves.",
        "options": { "appendAttribution": false, "senderName": "Reece Windows & Doors" }
      },
      "credentials": { "gmailOAuth2": { "id": "mTZ0abLJTGV5FMrz", "name": "updates@reecewindowsmail.com" } }
    },
    {
      "id": "b2000000-0000-4000-8000-0000000000ff",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 60],
      "parameters": { "content": "## 02 LF Approval Processor (Phase E — thin)\nThree triggers, one decision surface. Gmail replies on the approval thread and webhook button clicks both POST the raw text to /approval/decide, where the render service runs the §14 parser (DENY before APPROVE, sender allow-list, token→run resolution). approved → call 04; edit → call 03; deny/unauthorized/unknown → internal email only. The hourly schedule POSTs /reminders/tick, which sends at 24h and 48h and NEVER approves. Ships INACTIVE.\n\nNOTE: the two 'Trigger 0x' HTTP URLs point at this n8n instance's own webhook base — confirm the host at go-live." }
    }
  ],
  "connections": {
    "Gmail Trigger: approval replies": { "main": [[{ "node": "Extract token + sender + reply", "type": "main", "index": 0 }]] },
    "Extract token + sender + reply": { "main": [[{ "node": "Decide (render service §14)", "type": "main", "index": 0 }]] },
    "Decide (render service §14)": { "main": [[{ "node": "IF approved", "type": "main", "index": 0 }]] },
    "IF approved": { "main": [[{ "node": "Trigger 04 delivery", "type": "main", "index": 0 }], [{ "node": "IF edit", "type": "main", "index": 0 }]] },
    "IF edit": { "main": [[{ "node": "Trigger 03 revision", "type": "main", "index": 0 }], [{ "node": "Notify internal (deny / unauthorized / unclear)", "type": "main", "index": 0 }]] },
    "Webhook: decision buttons": { "main": [[{ "node": "Decide (button)", "type": "main", "index": 0 }, { "node": "Respond button", "type": "main", "index": 0 }]] },
    "Schedule: hourly reminders": { "main": [[{ "node": "Reminders tick", "type": "main", "index": 0 }]] },
    "Reminders tick": { "main": [[{ "node": "Split due reminders", "type": "main", "index": 0 }]] },
    "Split due reminders": { "main": [[{ "node": "Send reminder to approvers", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/New_York" }
}
