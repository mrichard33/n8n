{
  "name": "90 LF Manual Controls",
  "nodes": [
    {
      "id": "90000000-0000-4000-8000-000000000001",
      "name": "Webhook: manual op",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 360],
      "webhookId": "lf-manual-controls",
      "parameters": { "httpMethod": "POST", "path": "lf-manual", "responseMode": "responseNode", "options": {} }
    },
    {
      "id": "90000000-0000-4000-8000-000000000002",
      "name": "IF op = regenerate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 240],
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "combinator": "and",
          "conditions": [ { "id": "c-regen", "leftValue": "={{ $json.body.op }}", "rightValue": "regenerate", "operator": { "type": "string", "operation": "equals" } } ] }
      }
    },
    {
      "id": "90000000-0000-4000-8000-000000000003",
      "name": "Regenerate (force)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 180],
      "parameters": {
        "method": "POST",
        "url": "https://lf-report-render-production.up.railway.app/orchestrate/weekly",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_date: $json.body.run_date, force: true, manual_regeneration: true }) }}",
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "90000000-0000-4000-8000-000000000004",
      "name": "IF op = reminders",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 400],
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "combinator": "and",
          "conditions": [ { "id": "c-rem", "leftValue": "={{ $json.body.op }}", "rightValue": "reminders", "operator": { "type": "string", "operation": "equals" } } ] }
      }
    },
    {
      "id": "90000000-0000-4000-8000-000000000005",
      "name": "Reminders tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 360],
      "parameters": {
        "method": "POST",
        "url": "https://lf-report-render-production.up.railway.app/reminders/tick",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" } ] },
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "90000000-0000-4000-8000-000000000006",
      "name": "IF op = revise",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 560],
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 }, "combinator": "and",
          "conditions": [ { "id": "c-rev", "leftValue": "={{ $json.body.op }}", "rightValue": "revise", "operator": { "type": "string", "operation": "equals" } } ] }
      }
    },
    {
      "id": "90000000-0000-4000-8000-000000000007",
      "name": "Revise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 540],
      "parameters": {
        "method": "POST",
        "url": "https://lf-report-render-production.up.railway.app/revise",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" } ] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.body.run_id, revision_kind: $json.body.revision_kind || 'NARRATIVE_EDIT', instruction: $json.body.instruction || 'manual re-render', requested_by: $json.body.requested_by || 'manual', overrides: $json.body.overrides || null }) }}",
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "90000000-0000-4000-8000-0000000000fe",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 360],
      "parameters": { "respondWith": "json", "responseBody": "={{ JSON.stringify($json) }}" }
    },
    {
      "id": "90000000-0000-4000-8000-0000000000ff",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 100],
      "parameters": { "content": "## 90 LF Manual Controls (Phase E — thin)\nPOST { op, ... } to /webhook/lf-manual:\n- op=regenerate {run_date} → force a run (bypasses the kill switch; manual_regeneration=true)\n- op=reminders → run the 24h/48h reminder tick now\n- op=revise {run_id, revision_kind, instruction, overrides} → produce a new version\nAll work happens in the render service; this is just an operator entry point. Preview-without-email and external resend (which re-verifies the hash) are the /orchestrate and /deliver endpoints called with the appropriate flags. Ships INACTIVE." }
    }
  ],
  "connections": {
    "Webhook: manual op": { "main": [[{ "node": "IF op = regenerate", "type": "main", "index": 0 }, { "node": "Respond", "type": "main", "index": 0 }]] },
    "IF op = regenerate": { "main": [[{ "node": "Regenerate (force)", "type": "main", "index": 0 }], [{ "node": "IF op = reminders", "type": "main", "index": 0 }]] },
    "IF op = reminders": { "main": [[{ "node": "Reminders tick", "type": "main", "index": 0 }], [{ "node": "IF op = revise", "type": "main", "index": 0 }]] },
    "IF op = revise": { "main": [[{ "node": "Revise", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/New_York" }
}
