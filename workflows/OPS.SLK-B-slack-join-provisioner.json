      "onError": "continueErrorOutput",
      "notes": "One call per channel, 400 ms apart (Slack tier 3 = 50/min). Never Error is ON so already_in_channel and friends reach the collector instead of aborting the run."
    },
    {
      "parameters": {
        "jsCode": "const alerts = [];\nlet invited = 0;\nif ($('Invite to Channel').isExecuted) {\n  const wanted = $('Fan Out Invites').all().map((i) => i.json);\n  const results = $('Invite to Channel').all().map((i) => i.json);\n  results.forEach((r, idx) => {\n    const name = (wanted[idx] || {}).name || '?';\n    if (r.ok === true || r.error === 'already_in_channel') invited++;\n    else alerts.push('🟠 INVITE FAILED · #' + name + ' · ' + (r.error || 'unknown error'));\n  });\n}\nreturn [{ json: { invited, invite_alerts: alerts } }];"
      },
