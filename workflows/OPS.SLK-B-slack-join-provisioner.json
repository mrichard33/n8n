      "credentials": {
        "slackApi": {
          "id": "1OT2X5rtLCxwNgFI",
          "name": "Reece Bot"
        },
        "supabaseApi": {
          "id": "9QVXUFOAdIAIg4WH",
          "name": "LP Supabase"
        }
      },
      "notes": "Names → Slack channel ids. Any name with no row becomes a 🟠 MISSING CHANNEL alert downstream; the rest still proceed."
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Resolve Channels').first().json;\nconst rows = $('Lookup Slack Channels').all().map((i) => i.json).filter((r) => r.channel_name);\nconst byName = Object.fromEntries(rows.map((r) => [r.channel_name, r.slack_channel_id]));\nconst alerts = [...plan.alerts];\nconst invites = [];\nfor (const name of plan.channel_names) {\n  if (byName[name]) invites.push({ name, id: byName[name] });\n  else alerts.push('🟠 MISSING CHANNEL · ' + name + ' · not in slack_channels');\n}\nconst live = $env.SLACK_ONBOARDING_MODE === 'live';\nconst hasDispatch = plan.channel_names.includes('dispatch');\nconst names = invites.map((i) => '#' + i.name);\nlet dm = \"You're all set. Your channels: \" + names.join(', ') + '.';\nif (hasDispatch) dm += ' Urgent = call the Five9 dispatch line. Not urgent = post in #dispatch.';\nconst label = plan.first_name + ' ' + plan.last_name + ' · ' + plan.role + ' · ' + (plan.market_code || 'company-wide');\nconst shadow = '[SHADOW] ✅ ONBOARDED · ' + label + ' · ' + invites.length + ' channels'\n  + ' · would invite: ' + (invites.map((i) => '#' + i.name).join(', ') || 'none')\n  + ' · row left as-is (shadow)'\n  + (alerts.length ? '\\n' + alerts.join('\\n') : '');\nreturn [{ json: { ...plan, invites, live, mode: live ? 'live' : 'shadow', dm_text: dm, label, n_channels: invites.length, shadow_text: shadow, alerts } }];"
      },
