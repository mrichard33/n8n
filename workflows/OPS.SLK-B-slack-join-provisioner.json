    {
      "parameters": {
        "jsCode": "const plan = $('Plan Provisioning').first().json;\nconst alerts = [...plan.alerts];\nlet invited = 0;\nif ($('Collect Invite Results').isExecuted) {\n  const r = $('Collect Invite Results').first().json;\n  invited = r.invited;\n  alerts.push(...r.invite_alerts);\n}\nconst dm = $('Welcome DM').first().json;\nif (!dm || dm.ok !== true) alerts.push('🟠 DM FAILED · ' + ((dm && dm.error) || 'unknown error'));\nconst text = '✅ ONBOARDED · ' + plan.label + ' · ' + invited + ' channels'\n  + (invited < plan.invites.length ? ' (' + (plan.invites.length - invited) + ' failed)' : '')\n  + (alerts.length ? '\\n' + alerts.join('\\n') : '');\nreturn [{ json: { text } }];"
      },
