    {
      "parameters": {
        "jsCode": "// Select CSV attachments for report 138.\n//\n// DO NOT add a `_138_` filename regex. LP's CSV attachments are named\n// `_<YYMMDDHHMMSS>_Export.csv` and carry NO report id — a filename-id regex\n// matches zero attachments and the workflow silently emits nothing. That is\n// the live defect in the older PDF-era workflows (they still filter `_133_`,\n// `_134_`, etc.).\n//\n// Scoping happens in two places instead:\n//   1. the per-month Gmail subject queries above, and\n//   2. LP-MCP's header fingerprint, which is authoritative for report identity.\n//\n// Every message in the poll and every attachment in each message is examined,\n// so simultaneous arrivals all flow through.\nconst out = [];\nfor (const item of $input.all()) {\n  const bin = item.binary ?? {};\n  for (const key of Object.keys(bin)) {\n    const fileName = bin[key]?.fileName ?? '';\n    if (!/\\.csv$/i.test(fileName)) continue;\n    out.push({\n      json: { ...item.json, lp_report_id: '138', attachment_file_name: fileName },\n      binary: { attachment_0: bin[key] },\n    });\n  }\n}\nreturn out;"
      },
      "id": "50c9ef77-03ea-4a4d-82ba-8b80ece641ca",
      "name": "Select CSV attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4096,
        2960
      ]
    },
