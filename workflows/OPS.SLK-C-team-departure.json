      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2288,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "id": "02995299-fda4-4490-a99e-f4dd00c8a7d7",
      "credentials": {
        "supabaseApi": {
          "id": "9QVXUFOAdIAIg4WH",
          "name": "LP Supabase"
        }
      },
      "notes": "Names → Slack channel ids. Any name with no row becomes a 🟠 MISSING CHANNEL alert downstream; the rest still proceed."
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Resolve Channels').first().json;\nconst rows = $('Lookup Slack Channels').all().map((i) => i.json).filter((r) => r.channel_name);\nconst byName = Object.fromEntries(rows.map((r) => [r.channel_name, r.slack_channel_id]));\nconst alerts = [...plan.alerts];\n// Slack refuses conversations.kick on default channels (restricted_action).\n// A deactivated account cannot read or post anywhere, so skip them rather than\n// firing calls that always fail and fill #ops-alerts with noise.\nconst DEFAULT_CHANNELS = ['announcements', 'general'];\nconst kicks = [];\nconst skipped = [];\nfor (const name of plan.channel_names) {\n  if (DEFAULT_CHANNELS.includes(name)) { skipped.push('#' + name); continue; }\n  if (byName[name]) kicks.push({ name, id: byName[name] });\n  else alerts.push('🟠 MISSING CHANNEL · ' + name + ' · not in slack_channels, cannot remove');\n}\nconst live = $env.SLACK_ONBOARDING_MODE === 'live';\nconst label = plan.first_name + ' ' + plan.last_name + ' · ' + plan.role + ' · ' + (plan.market_code || 'company-wide');\nconst shadow = '[SHADOW] 🟠 DEPARTURE · ' + label\n  + ' · would remove from ' + kicks.length + ' channels (' + (kicks.map((k) => '#' + k.name).join(', ') || 'none') + ')'\n  + ' · row left as-is (shadow)'\n  + (skipped.length ? ' · default channels left in place: ' + skipped.join(', ') : '')\n  + (alerts.length ? '\\n' + alerts.join('\\n') : '');\nreturn [{ json: { ...plan, kicks, skipped, live, mode: live ? 'live' : 'shadow', label, shadow_text: shadow, alerts } }];"
      },
