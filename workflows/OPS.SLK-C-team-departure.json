    {
      "name": "Plan Departure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        0
      ],
      "parameters": {
        "jsCode": "const plan = $('Resolve Channels').first().json;\nconst member = $('Lookup Member').first().json;\nconst rows = $('Lookup Slack Channels').all().map((i) => i.json).filter((r) => r.channel_name);\nconst byName = Object.fromEntries(rows.map((r) => [r.channel_name, r.slack_channel_id]));\nconst alerts = [...plan.alerts];\nconst kicks = [];\nfor (const name of plan.channel_names) {\n  if (byName[name]) kicks.push({ name, id: byName[name] });\n  else alerts.push('🟠 MISSING CHANNEL · ' + name + ' · not in slack_channels, cannot remove');\n}\n// Rep channel: the id stored at onboarding wins; fall back to the registry row by name.\nconst repChannelId = member.rep_channel_id || (plan.rep_channel_name ? byName[plan.rep_channel_name] : null) || null;\nconst live = $env.SLACK_ONBOARDING_MODE === 'live';\nconst label = plan.first_name + ' ' + plan.last_name + ' · ' + plan.role + ' · ' + (plan.market_code || 'company-wide');\nconst shadow = '[SHADOW] 🟠 DEPARTURE · ' + label\n  + ' · would remove from ' + kicks.length + ' channels (' + (kicks.map((k) => '#' + k.name).join(', ') || 'none') + ')'\n  + (repChannelId ? ' · would archive rep channel ' + repChannelId : ' · no rep channel')\n  + ' · row left as-is (shadow) · DEACTIVATE SLACK ACCOUNT MANUALLY (Enterprise-only API)'\n  + (alerts.length ? '\\n' + alerts.join('\\n') : '');\nreturn [{ json: { ...plan, kicks, rep_channel_id: repChannelId, live, mode: live ? 'live' : 'shadow', label, shadow_text: shadow, alerts } }];"
      },
      "id": "9fdeb3d6-3839-45e4-a2a3-009e58cb17db"
    },
