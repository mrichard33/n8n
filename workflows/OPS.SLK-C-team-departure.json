    {
      "name": "Resolve Channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        0
      ],
      "parameters": {
        "jsCode": "function resolveChannels(patterns, marketSlug) {\n  const out = [];\n  for (const p of patterns) {\n    const pattern = String(p || '').trim();\n    if (!pattern) continue;\n    if (pattern.includes('<market>')) {\n      if (!marketSlug) continue;\n      out.push(pattern.replace('<market>', marketSlug));\n    } else {\n      out.push(pattern);\n    }\n  }\n  return [...new Set(out)];\n}\n\n// Same algorithm as slugify() in slack-onboarding-normalize.js. It is repeated\n// here because team_members stores first/last name, not the slug, so B and C\n// re-derive it — and the n8n Code node can only embed one file.\nfunction slugify(s) {\n  return String(s || '')\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '');\n}\n\n// Per-rep private channel: sales-<market>-<firstname>-<lastname>.\n// Slack caps channel names at 80 characters.\nfunction repChannelName(marketSlug, slug) {\n  return `sales-${marketSlug}-${slug}`.slice(0, 80);\n}\n\n// ---- workflow glue (the functions above are scripts/lib/slack-onboarding-resolve.js) ----\nconst member = $('Lookup Member').first().json;\nconst patterns = $('Lookup Role Channels').all().map((i) => i.json.channel_pattern).filter(Boolean);\nconst marketRow = $('Lookup Market Slug').first().json || {};\nconst marketSlug = marketRow.slug || '';\nconst alerts = [];\nif (patterns.length === 0) alerts.push('🟠 NO ROLE MAPPING · slack_role_channels has no rows for role ' + member.role);\nif (member.market_code && !marketSlug) alerts.push('🟠 UNKNOWN MARKET · slack_market_slugs has no row for ' + member.market_code);\nconst channelNames = resolveChannels(patterns, marketSlug);\nconst slug = slugify(member.first_name) + '-' + slugify(member.last_name);\nlet repChannel = null;\nif (member.role === 'sales_rep') {\n  if (marketSlug) repChannel = repChannelName(marketSlug, slug);\n  else alerts.push('🟠 NO REP CHANNEL · sales_rep ' + member.email + ' has no market, so the rep channel cannot be named');\n}\nreturn [{ json: {\n  member_id: member.id,\n  email: member.email,\n  first_name: member.first_name,\n  last_name: member.last_name,\n  role: member.role,\n  market_code: member.market_code || null,\n  market_slug: marketSlug,\n  slack_user_id: member.slack_user_id,\n  channel_names: channelNames,\n  rep_channel_name: repChannel,\n  lookup_names: repChannel ? channelNames.concat([repChannel]) : channelNames,\n  alerts\n} }];"
      },
      "id": "9a85aed2-ea92-4141-a134-79e82a43a55a"
    },
