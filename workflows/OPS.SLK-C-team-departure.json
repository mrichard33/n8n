      ],
      "parameters": {
        "jsCode": "const alerts = [];\nlet removed = 0;\nif ($('Kick From Channel').isExecuted) {\n  const wanted = $('Fan Out Kicks').all().map((i) => i.json);\n  const results = $('Kick From Channel').all().map((i) => i.json);\n  results.forEach((r, idx) => {\n    const name = (wanted[idx] || {}).name || '?';\n    if (r.ok === true || r.error === 'not_in_channel') removed++;\n    else alerts.push('🟠 KICK FAILED · #' + name + ' · ' + (r.error || 'unknown error'));\n  });\n}\nreturn [{ json: { removed, kick_alerts: alerts } }];"
