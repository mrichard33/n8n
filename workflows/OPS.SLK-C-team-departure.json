        "path": "team-departure",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Departure Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "a4ca8956-e162-46dd-a6b0-2705482a8435",
