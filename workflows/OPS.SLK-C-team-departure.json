    {
      "name": "Compose Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4660,
        0
      ],
      "parameters": {
        "jsCode": "const plan = $('Plan Departure').first().json;\nconst alerts = [...plan.alerts];\nlet removed = 0;\nif ($('Collect Kick Results').isExecuted) {\n  const r = $('Collect Kick Results').first().json;\n  removed = r.removed;\n  alerts.push(...r.kick_alerts);\n}\nlet rep = ' · no rep channel';\nif ($('Archive Rep Channel').isExecuted) {\n  const a = $('Archive Rep Channel').first().json;\n  rep = (a.ok === true || a.error === 'already_archived') ? ' · rep channel archived' : ' · rep channel NOT archived (' + (a.error || 'unknown error') + ')';\n}\nconst text = '🟠 DEPARTURE · ' + plan.label + ' · removed from ' + removed + ' channels' + rep\n  + ' · DEACTIVATE SLACK ACCOUNT MANUALLY (Enterprise-only API)'\n  + (alerts.length ? '\\n' + alerts.join('\\n') : '');\nreturn [{ json: { text } }];"
      },
      "id": "824c226f-b7e3-406f-a1a7-b20aa2ff80a9"
