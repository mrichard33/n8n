    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers || {};\nconst body = item.body || {};\nconst expected = String($env.SLACK_DEPARTURE_TOKEN || '');\nconst given = String(headers['x-departure-token'] || '');\nlet same = expected.length > 0 && expected.length === given.length;\nfor (let i = 0; i < expected.length; i++) same = (expected.charCodeAt(i) === (given.charCodeAt(i) || -1)) && same;\nconst email = String(body.email || '').trim().toLowerCase();\nconst live = $env.SLACK_ONBOARDING_MODE === 'live';\nlet status = 200, response = { accepted: true, email, mode: live ? 'live' : 'shadow' };\nif (!same) { status = 401; response = { error: expected ? 'bad x-departure-token' : 'SLACK_DEPARTURE_TOKEN is not set on the n8n service' }; }\nelse if (!email.includes('@')) { status = 400; response = { error: 'body.email is required' }; }\nreturn [{ json: { status, response, authorized: status === 200, email, live } }];"
      },
