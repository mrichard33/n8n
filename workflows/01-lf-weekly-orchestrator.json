{
  "name": "01 LF Weekly Orchestrator",
  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Schedule: Monday 08:00 ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8 * * 1" }
          ]
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Run weekly pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "parameters": {
        "method": "POST",
        "url": "https://lf-report-render-production.up.railway.app/orchestrate/weekly",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_date: $now.setZone('America/New_York').toFormat('yyyy-MM-dd') }) }}",
        "options": { "timeout": 120000 }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "IF ready for review",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [800, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-ready",
              "leftValue": "={{ $json.status }}",
              "rightValue": "READY_FOR_REVIEW",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Fetch approval PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 200],
      "parameters": {
        "method": "GET",
        "url": "=https://lf-report-render-production.up.railway.app{{ $json.email.pdf_path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Render-Token", "value": "={{ $env.RENDER_TOKEN }}" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } },
          "timeout": 60000
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Email approval to approvers",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1360, 200],
      "parameters": {
        "sendTo": "={{ $('Run weekly pipeline').item.json.email.to.join(',') }}",
        "subject": "={{ $('Run weekly pipeline').item.json.email.subject }}",
        "emailType": "html",
        "message": "={{ $('Run weekly pipeline').item.json.email.html }}",
        "options": {
          "appendAttribution": false,
          "senderName": "Reece Windows & Doors",
          "attachmentsUi": { "attachmentsBinary": [ { "property": "data" } ] }
        }
      },
      "credentials": {
        "gmailOAuth2": { "id": "mTZ0abLJTGV5FMrz", "name": "updates@reecewindowsmail.com" }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Email internal: not sendable",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1080, 420],
      "parameters": {
        "sendTo": "updates@reecewindowsmail.com",
        "subject": "=Lightfire weekly — {{ $json.status }} (no report sent)",
        "emailType": "text",
        "message": "=The weekly Lightfire pipeline finished in state {{ $json.status }} and produced no approval email.\n\nrun_id: {{ $json.run_id || '—' }}\nreasons: {{ ($json.reasons || []).join('; ') || '—' }}\n\nThis is an internal notification. Nothing was sent to the vendor.",
        "options": { "appendAttribution": false, "senderName": "Reece Windows & Doors" }
      },
      "credentials": {
        "gmailOAuth2": { "id": "mTZ0abLJTGV5FMrz", "name": "updates@reecewindowsmail.com" }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-0000000000ff",
      "name": "Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 120],
      "parameters": {
        "content": "## 01 LF Weekly Orchestrator (Phase E — thin)\nMonday 08:00 America/New_York. Calls the render service, which owns all LP I/O, the maturity rule and every gate. On READY_FOR_REVIEW it emails Mark + Brad the approval request with the PDF attached; any other terminal state emails an internal alert only. Ships INACTIVE. Kill switch is the lf_report_config.report_enabled DB row (the service exits DISABLED unless true)."
      }
    }
  ],
  "connections": {
    "Schedule: Monday 08:00 ET": { "main": [[{ "node": "Run weekly pipeline", "type": "main", "index": 0 }]] },
    "Run weekly pipeline": { "main": [[{ "node": "IF ready for review", "type": "main", "index": 0 }]] },
    "IF ready for review": {
      "main": [
        [{ "node": "Fetch approval PDF", "type": "main", "index": 0 }],
        [{ "node": "Email internal: not sendable", "type": "main", "index": 0 }]
      ]
    },
    "Fetch approval PDF": { "main": [[{ "node": "Email approval to approvers", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/New_York" }
}
