    {
      "parameters": {
        "jsCode": "const members = $('Keep Found').all().map(i => i.json);\nconst roleRows = $('Lookup Role Channels').all().map(i => i.json);\nconst slugRows = $('Lookup Market Slugs').all().map(i => i.json);\nconst chanRows = $('Lookup Slack Channels').all().map(i => i.json).filter(r => r.channel_name);\nconst watcherRows = $('Lookup Watchers').all().map(i => i.json).filter(r => r.slack_user_id);\n\nconst slugOf = Object.fromEntries(slugRows.map(r => [r.market_code, r.slug]));\nconst idOf = Object.fromEntries(chanRows.map(r => [r.channel_name, r.slack_channel_id]));\nconst allChannelIds = chanRows.map(r => r.slack_channel_id);\n// Per-rep private channels were removed on 2026-09-14 — reps live in their\n// market's #sales-<market> channel. watch_scope 'rep_channels' therefore now\n// means every market sales channel, which is where rep traffic actually is.\nconst salesChannelIds = chanRows.filter(r => r.channel_type === 'sales').map(r => r.slack_channel_id);\nconst live = $env.SLACK_ONBOARDING_MODE === 'live';\n\nconst invites = [];   // { channel, users, label }\nconst summary = [];   // { text, newly } — newly = linked on THIS run\nconst alerts = [];\n\nfor (const m of members) {\n  const slug = m.market_code ? slugOf[m.market_code] : null;\n  if (m.market_code && !slug) alerts.push('🟠 UNKNOWN MARKET · ' + m.email + ' · ' + m.market_code);\n\n  const patterns = roleRows.filter(r => r.role === m.role).map(r => r.channel_pattern);\n  if (!patterns.length) alerts.push('🟠 NO ROLE MAPPING · ' + m.email + ' · ' + m.role);\n\n  const names = [];\n  for (const p of patterns) {\n    if (p.includes('<market>')) { if (slug) names.push(p.replace('<market>', slug)); }\n    else names.push(p);\n  }\n  const uniq = [...new Set(names)];\n\n  const got = [];\n  for (const n of uniq) {\n    if (idOf[n]) { invites.push({ channel: idOf[n], users: m.slack_user_id, label: m.email + ' → #' + n }); got.push('#' + n); }\n    else alerts.push('🟠 MISSING CHANNEL · ' + n + ' · not in slack_channels');\n  }\n\n  // If THIS person is a watcher, pull them into the channels they watch.\n  //   'all'          -> every channel in the registry\n  //   'rep_channels' -> every market sales channel (dispatch + sales managers)\n  if (m.watch_scope === 'all' || m.watch_scope === 'rep_channels') {\n    const targets = m.watch_scope === 'all' ? allChannelIds : salesChannelIds;\n    const alreadyInvited = new Set(uniq.map((n) => idOf[n]).filter(Boolean));\n    let n = 0;\n    for (const cid of targets) {\n      if (alreadyInvited.has(cid)) continue;\n      invites.push({ channel: cid, users: m.slack_user_id, label: m.email + ' (watcher) → ' + cid });\n      n++;\n    }\n    got.push('+' + n + ' as watcher');\n  }\n\n  summary.push({\n    text: m.first_name + ' ' + m.last_name + ' · ' + m.role + ' · ' + (m.market_code || 'company-wide') + ' · ' + (got.join(', ') || 'no channels'),\n    newly: m._newly_linked === true,\n  });\n}\n\n// de-dupe identical channel+users pairs\nconst seen = new Set();\nconst deduped = invites.filter(v => { const k = v.channel + '|' + v.users; if (seen.has(k)) return false; seen.add(k); return true; });\n\nconst memberIds = members.map(m => m.id);\nconst newlyLinkedCount = summary.filter(s => s.newly).length;\nreturn [{ json: { live, linked: members.length, newly_linked_count: newlyLinkedCount, member_ids: memberIds, invites: deduped, invite_count: deduped.length, summary, alerts } }];"
      },
