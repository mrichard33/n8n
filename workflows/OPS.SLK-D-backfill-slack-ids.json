    {
      "parameters": {
        "jsCode": "const src = $('Find Unlinked').all().map(i => i.json);\nconst out = [];\nconst misses = [];\n$input.all().forEach((r, i) => {\n  const m = src[i];\n  if (!m) return;\n  const j = r.json;\n  // true only on the run that FIRST links this person (row had no slack_user_id)\n  const newly = !m.slack_user_id;\n  if (j.ok === true && j.user && j.user.id) {\n    out.push({ json: { ...m, slack_user_id: j.user.id, _newly_linked: newly } });\n  } else if (m.slack_user_id) {\n    // already linked (watcher re-check) — keep them, lookup not required\n    out.push({ json: { ...m, _newly_linked: false } });\n  } else if (j.error && j.error !== 'users_not_found') {\n    misses.push('⚠ LOOKUP · ' + m.email + ' · ' + j.error);\n  }\n});\nif (misses.length) console.log(misses.join('\\n'));\nreturn out;\n"
      },
