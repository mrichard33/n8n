      "name": "Lookup Watchers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1648,
        192
      ],
      "id": "5af5c053-c6fd-4935-9ec2-7035fa819938",
