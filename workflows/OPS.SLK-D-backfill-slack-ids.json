      "name": "Invite Backfill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2528,
        112
      ],
      "id": "569d4857-8034-4356-9d29-5fb8e05de1ca",
      "credentials": {
        "slackApi": {
          "id": "1OT2X5rtLCxwNgFI",
          "name": "Reece Bot"
        }
