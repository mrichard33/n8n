    },
    {
      "parameters": {
        "jsCode": "const p = $('Plan Backfill').first().json;\nconst fan = $('Fan Out Backfill Invites').isExecuted ? $('Fan Out Backfill Invites').all().map(i => i.json) : [];\nconst res = $('Invite Backfill').isExecuted ? $('Invite Backfill').all().map(i => i.json) : [];\n\n// 2026-09-11 — POST ONLY WHAT CHANGED.\n// The hourly watcher re-check re-sends every invite on purpose, so watchers\n// land in channels created since the last run. Almost all of those come back\n// already_in_channel = nothing happened. Counting them as \"invites ok\" made\n// every hour look like fresh work and posted the same card 24x a day.\n// News is: someone newly linked, Slack actually adding someone (ok:true),\n// a failed invite, or a planning alert.\nconst added = [];\nconst failed = [];\nres.forEach((r, i) => {\n  const label = fan[i] ? fan[i].label : 'unknown';\n  const already = r.error === 'already_in_channel'\n    || (Array.isArray(r.errors) && r.errors.length > 0 && r.errors.every(e => e.error === 'already_in_channel'));\n  if (r.ok === true) added.push(label);\n  else if (!already) failed.push('🟠 INVITE · ' + label + ' · ' + (r.error || 'unknown'));\n});\n\nconst newly = (p.summary || []).filter(s => s && s.newly).map(s => s.text);\nconst alerts = p.alerts || [];\nconst changed = newly.length > 0 || added.length > 0 || failed.length > 0 || alerts.length > 0;\nif (!changed) return []; // nothing new — stay silent (no card)\n\nconst tag = p.live ? '✅ BACKFILL' : '[SHADOW] ✅ BACKFILL';\nconst lines = [\n  tag + ' · ' + newly.length + ' newly linked · '\n    + (p.live ? added.length + ' new channel add(s)' : p.invite_count + ' invites planned (none sent)')\n];\nnewly.forEach(s => lines.push('• ' + s));\nadded.slice(0, 15).forEach(a => lines.push('➕ ' + a));\nif (added.length > 15) lines.push('…and ' + (added.length - 15) + ' more');\nalerts.forEach(a => lines.push(a));\nfailed.forEach(f => lines.push(f));\nconst text = lines.join('\\n');\n\n// A problem nobody has fixed yet (e.g. a missing channel) repeats the same\n// text every hour. Say it at most once a day.\nconst sd = $getWorkflowStaticData('global');\nconst now = Date.now();\nif (sd.lastText === text && now - (sd.lastAt || 0) < 24 * 60 * 60 * 1000) return [];\nsd.lastText = text;\nsd.lastAt = now;\nreturn [{ json: { text } }];\n"
      },
